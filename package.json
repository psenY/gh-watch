{
  "name": "gh-watch",
  "version": "0.1.1",
  "description": "GitHub PR/issue 变更监视插件：检测变更并自动拉起对话通知 AI（多 AI 独立配置，插件自身不审查、不回帖）",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "node -e \"process.exit(0)\"",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node --input-type=module -e \"import{name,inject,apply}from'./lib/index.js';if(name!=='gh-watch')throw Error('name');if(!Array.isArray(inject))throw Error('inject');if(typeof apply!=='function')throw Error('apply');console.log('smoke ok')\""
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  }
}
